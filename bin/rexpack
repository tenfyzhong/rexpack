#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
command_name=${1:-help}
if [ "$#" -gt 0 ]; then shift; fi
config=${XDG_CONFIG_HOME:-"$HOME/.config"}/rex/rexpack_config.lua
name=
json=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --config) [ "$#" -ge 2 ] || { echo 'Missing --config path' >&2; exit 2; }; config=$2; shift ;;
        --json) json=1 ;;
        --*) echo "Unknown option: $1" >&2; exit 2 ;;
        *) [ -z "$name" ] || { echo 'Only one plugin name is accepted' >&2; exit 2; }; name=$1 ;;
    esac
    shift
done
case "$command_name" in
    help|--help|-h) echo 'rexpack {install|update|restore|build|list|show|profile} [name] [--config PATH] [--json]'; exit 0 ;;
    install|update|restore|build|list|show|profile) ;;
    *) echo "Unknown command: $command_name" >&2; exit 2 ;;
esac
rex_bin=${REX_BIN:-}
if [ -z "$rex_bin" ]; then rex_bin=$(command -v rex || true); fi
if [ -z "$rex_bin" ]; then
    for candidate in \
        "$HOME/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS/rex" \
        '/Applications/Rex Beta.app/Contents/Helpers/Rex Server.rex/Contents/MacOS/rex'; do
        if [ -x "$candidate" ]; then rex_bin=$candidate; break; fi
    done
fi
[ -n "$rex_bin" ] || { echo 'Rex not found; set REX_BIN or add rex to PATH' >&2; exit 1; }
export REXPACK_ROOT="$root" REXPACK_COMMAND="$command_name" REXPACK_CONFIG="$config" REXPACK_NAME="$name" REXPACK_JSON="$json"
exec "$rex_bin" --autostart=false do "$root/cli.lua"
